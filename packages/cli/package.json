{
  "name": "@thoth-runtime/cli",
  "version": "0.5.0",
  "description": "Thoth CLI — start, dev, doctor, init, smoke, migrate.",
  "license": "MIT",
  "type": "commonjs",
  "main": "./src/index.ts",
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts"
  },
  "bin": {
    "thoth": "./bin/thoth.js"
  },
  "files": ["dist", "src", "bin", "README.md", "LICENSE"],
  "homepage": "https://thoth-runtime.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/thoth-runtime/thoth.git",
    "directory": "packages/cli"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "start": "tsx src/index.ts start",
    "dev": "tsx watch src/index.ts start",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "smoke": "tsx ../../scripts/smoke-claude.ts"
  },
  "dependencies": {
    "@slack/bolt": "^4.4.0",
    "@thoth-runtime/core": "workspace:*",
    "@thoth-runtime/sdk": "workspace:*",
    "commander": "^12.1.0",
    "dotenv": "^16.4.7",
    "kleur": "^4.1.5"
  },
  "devDependencies": {
    "tsx": "^4.19.2",
    "vitest": "^2.1.8"
  }
}
