{
  "name": "@thoth-runtime/core",
  "version": "0.5.0",
  "description": "Thoth — core runtime: 5-layer memory, persona stack, Reflexion loop, skill compilation, multi-agent party, Slack adapter, dashboard. v0.5 ships as a monolith; v0.6 splits transports + dashboard into peer packages.",
  "license": "MIT",
  "type": "commonjs",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts"
  },
  "files": ["dist", "src", "README.md", "LICENSE"],
  "homepage": "https://thoth-runtime.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/thoth-runtime/thoth.git",
    "directory": "packages/core"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@slack/bolt": "^4.4.0",
    "@slack/web-api": "^7.10.0",
    "@thoth-runtime/sdk": "workspace:*",
    "@xenova/transformers": "^2.17.2",
    "better-sqlite3": "^11.7.0",
    "dotenv": "^17.4.2",
    "pino": "^9.5.0",
    "pino-pretty": "^13.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "vitest": "^2.1.8"
  }
}
