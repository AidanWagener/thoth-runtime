# operator-agent example — environment variables
# Setting: fictional Helios Tools / Maya Kepler

# === Slack credentials ============================================
# Get these from https://api.slack.com/apps after installing your app.
SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...
SLACK_SIGNING_SECRET=...

# Comma-separated list of Slack user IDs allowed to talk to the bot.
# Find your member ID in Slack: profile -> 'Copy member ID'.
ALLOWED_USERS=U_YOUR_ID

# === Honcho identity layer ========================================
# Recommended for the operator-agent example — gives the bot per-peer
# theory-of-mind. Free tier at https://app.honcho.dev/
HONCHO_API_KEY=hch-v1-...

# === Tools (fictional, replace with your actual services) =========
# These are the tools the operator-agent persona expects. None are
# strictly required to start the bridge — but the persona references
# them and will tell you when they're missing.

GITHUB_TOKEN=ghp_your_pat_here
VERCEL_TOKEN=...
SENTRY_API_TOKEN=...
LINEAR_API_KEY=lin_api_...
RESEND_API_KEY=re_...
HELIOS_PG_USER=helios_diagnostics_readonly
HELIOS_PG_PASSWORD=...
STATUSPAGE_TOKEN=...
GRAFANA_API_KEY=...

# === Optional: logging ============================================
# LOG_LEVEL=info  # debug | info | warn | error

# === Required absences ============================================
# These MUST NOT be set — they would bypass your Claude Max
# subscription and bill against the API instead.
# (the bridge refuses to start if any are present)
#
# - ANTHROPIC_API_KEY
# - ANTHROPIC_AUTH_TOKEN
# - CLAUDE_CODE_USE_BEDROCK
# - CLAUDE_CODE_USE_VERTEX
# - CLAUDE_CODE_USE_FOUNDRY
