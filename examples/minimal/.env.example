# Minimal Thoth example — environment variables

# === Slack credentials ============================================
# Get these from https://api.slack.com/apps after installing your app.
SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...
SLACK_SIGNING_SECRET=...

# Comma-separated list of Slack user IDs allowed to talk to the bot.
# Find your member ID in Slack: profile -> 'Copy member ID'.
ALLOWED_USERS=U_YOUR_ID

# === Optional: Honcho identity layer ==============================
# Uncomment to enable theory-of-mind on each peer.
# Get a free API key at https://app.honcho.dev/
# HONCHO_API_KEY=hch-...
# HONCHO_WORKSPACE=my-thoth-workspace

# === Optional: logging ============================================
# LOG_LEVEL=info  # debug | info | warn | error

# === Required absences ============================================
# These MUST NOT be set — they would bypass your Claude Max
# subscription and bill against the API instead.
# (the bridge refuses to start if any are present)
#
# - ANTHROPIC_API_KEY
# - ANTHROPIC_AUTH_TOKEN
# - CLAUDE_CODE_USE_BEDROCK
# - CLAUDE_CODE_USE_VERTEX
# - CLAUDE_CODE_USE_FOUNDRY
